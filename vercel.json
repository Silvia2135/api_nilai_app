{
  "rewrites": [
    {
      "source": "/",
      "destination": "/data/nilai.json"
    }
  ],
  "headers": [
    {
      "source": "/data/nilai.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}